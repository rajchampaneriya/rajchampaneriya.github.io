<mxfile host="app.diagrams.net" agent="rajc.work ADR generator" version="24.0.0"><diagram id="adr-001" name="ADR-001 Pipeline vs Agent"><mxGraphModel dx="1400" dy="1568" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1568" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="rounded=1;arcSize=2;fillColor=#FFFFFF;strokeColor=#DCE2EA;html=1;" vertex="1" parent="1"><mxGeometry x="0.0" y="0.0" width="1400.0" height="1568.0" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;ADR-001: Architecture Decision Record&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=15;fontColor=#2256A0;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40.0" y="40.0" width="900.0" height="23.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;Run the daily coach as a scripted pipeline, not an autonomous agent&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=34;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40.0" y="70.0" width="1320.0" height="42.8" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Status:&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=15;fontColor=#606673;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40.0" y="122.8" width="59.7" height="23.0" as="geometry"/></mxCell><mxCell id="c6" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Accepted&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=15;fontColor=#606673;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="95.7" y="122.8" width="67.5" height="23.0" as="geometry"/></mxCell><mxCell id="c7" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Date:&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=15;fontColor=#606673;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="195.3" y="122.8" width="47.4" height="23.0" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;27 September 2026&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=15;fontColor=#606673;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="238.6" y="122.8" width="139.6" height="23.0" as="geometry"/></mxCell><mxCell id="c9" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Decider:&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=15;fontColor=#606673;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="410.2" y="122.8" width="68.6" height="23.0" as="geometry"/></mxCell><mxCell id="c10" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Raj Champaneriya&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=15;fontColor=#606673;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="474.8" y="122.8" width="125.7" height="23.0" as="geometry"/></mxCell><mxCell id="c11" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;System:&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=15;fontColor=#606673;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="632.5" y="122.8" width="66.3" height="23.0" as="geometry"/></mxCell><mxCell id="c12" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;FDE Impromptu Coach&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=15;fontColor=#606673;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="694.8" y="122.8" width="157.2" height="23.0" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;fillColor=#F3F5F8;strokeColor=#DCE2EA;strokeWidth=1.0;html=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="162.8" width="648.0" height="150.0" as="geometry"/></mxCell><mxCell id="c14" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;Context&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=21;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="62.0" y="184.8" width="300.0" height="27.2" as="geometry"/></mxCell><mxCell id="c15" value="&lt;div style=&quot;line-height:1.5;&quot;&gt;Every day at 05:30, unattended on a Mac: write five new questions, build the deck, record five minutes on camera, upload privately to YouTube, and chase me until I record. The daily streak must never break.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=16;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="62.0" y="218.8" width="604.0" height="74.0" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;fillColor=#2256A0;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="712.0" y="162.8" width="648.0" height="150.0" as="geometry"/></mxCell><mxCell id="c17" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;Decision&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=21;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="734.0" y="184.8" width="300.0" height="27.2" as="geometry"/></mxCell><mxCell id="c18" value="&lt;div style=&quot;line-height:1.5;&quot;&gt;Code runs the routine. Claude is called once a day for the one step that needs judgment: writing the questions. Its output is schema- and novelty-checked, with a 132-question bank as fallback.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=16;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="734.0" y="218.8" width="604.0" height="74.0" as="geometry"/></mxCell><mxCell id="c19" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;Five dimensions&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=20;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40.0" y="447.7" width="300.0" height="26.0" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#EAF0F8;strokeColor=#2256A0;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="352.0" y="344.8" width="433.0" height="128.9" as="geometry"/></mxCell><mxCell id="c21" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;Option A: pipeline + one LLM call&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=18;fontColor=#2256A0;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="370.0" y="362.8" width="307.0" height="25.4" as="geometry"/></mxCell><mxCell id="c22" value="" style="rounded=1;absoluteArcSize=1;arcSize=26;fillColor=#2256A0;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="689.0" y="360.8" width="78.0" height="26.0" as="geometry"/></mxCell><mxCell id="c23" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;Chosen&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=13;fontColor=#FFFFFF;align=center;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="689.0" y="365.8" width="78.0" height="17.6" as="geometry"/></mxCell><mxCell id="c24" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;launchd starts Python at 05:30. Code builds the deck, drives QuickTime and PowerPoint, and calls the YouTube and Calendar APIs. claude -p writes the questions.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="370.0" y="394.8" width="397.0" height="62.9" as="geometry"/></mxCell><mxCell id="c25" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#DCE2EA;strokeWidth=1.5;html=1;" vertex="1" parent="1"><mxGeometry x="797.0" y="344.8" width="433.0" height="128.9" as="geometry"/></mxCell><mxCell id="c26" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;Option B: autonomous agent&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=18;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="815.0" y="362.8" width="397.0" height="25.4" as="geometry"/></mxCell><mxCell id="c27" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;A scheduled Claude agent with shell, file, API and computer-use tools runs the whole routine from a goal prompt, deciding each step as it goes.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="815.0" y="394.8" width="397.0" height="62.9" as="geometry"/></mxCell><mxCell id="c28" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;Winner&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=20;fontColor=#151A28;align=center;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1242.0" y="447.7" width="118.0" height="26.0" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#F3F5F8;strokeColor=#DCE2EA;strokeWidth=1.0;html=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="485.7" width="300.0" height="108.0" as="geometry"/></mxCell><mxCell id="c30" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;Reliability&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=19;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="56.0" y="501.7" width="268.0" height="26.7" as="geometry"/></mxCell><mxCell id="c31" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Same result at 05:30 every day, with nobody watching?&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14;fontColor=#606673;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="56.0" y="535.7" width="268.0" height="41.2" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#E7F4EC;strokeColor=#2E7D4F;strokeWidth=1.5;html=1;" vertex="1" parent="1"><mxGeometry x="352.0" y="485.7" width="433.0" height="108.0" as="geometry"/></mxCell><mxCell id="c33" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#2E7D4F;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="368.0" y="501.7" width="70.0" height="24.0" as="geometry"/></mxCell><mxCell id="c34" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;Strong&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=13;fontColor=#FFFFFF;align=center;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="368.0" y="505.7" width="70.0" height="17.6" as="geometry"/></mxCell><mxCell id="c35" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;One fixed code path. A failure found once is fixed once, in code, and stays fixed.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="368.0" y="535.7" width="401.0" height="44.0" as="geometry"/></mxCell><mxCell id="c36" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FCE9E7;strokeColor=#B83A2E;strokeWidth=1.5;html=1;" vertex="1" parent="1"><mxGeometry x="797.0" y="485.7" width="433.0" height="108.0" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#B83A2E;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="813.0" y="501.7" width="70.0" height="24.0" as="geometry"/></mxCell><mxCell id="c38" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;Weak&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=13;fontColor=#FFFFFF;align=center;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="813.0" y="505.7" width="70.0" height="17.6" as="geometry"/></mxCell><mxCell id="c39" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;The plan can differ run to run. Desktop clicks, dialogs and permission prompts break unattended runs.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="813.0" y="535.7" width="401.0" height="44.0" as="geometry"/></mxCell><mxCell id="c40" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#DCE2EA;strokeWidth=1.0;html=1;" vertex="1" parent="1"><mxGeometry x="1242.0" y="485.7" width="118.0" height="108.0" as="geometry"/></mxCell><mxCell id="c41" value="" style="ellipse;fillColor=#2256A0;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="1279.0" y="509.7" width="44.0" height="44.0" as="geometry"/></mxCell><mxCell id="c42" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;A&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=22;fontColor=#FFFFFF;align=center;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1242.0" y="517.7" width="118.0" height="28.4" as="geometry"/></mxCell><mxCell id="c43" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;pipeline&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=12.5;fontColor=#606673;align=center;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1242.0" y="559.7" width="118.0" height="17.0" as="geometry"/></mxCell><mxCell id="c44" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#F3F5F8;strokeColor=#DCE2EA;strokeWidth=1.0;html=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="605.8" width="300.0" height="108.0" as="geometry"/></mxCell><mxCell id="c45" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;Cost&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=19;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="56.0" y="621.8" width="268.0" height="26.7" as="geometry"/></mxCell><mxCell id="c46" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Model usage per day, and exposure to usage limits&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14;fontColor=#606673;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="56.0" y="655.8" width="268.0" height="41.2" as="geometry"/></mxCell><mxCell id="c47" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#E7F4EC;strokeColor=#2E7D4F;strokeWidth=1.5;html=1;" vertex="1" parent="1"><mxGeometry x="352.0" y="605.8" width="433.0" height="108.0" as="geometry"/></mxCell><mxCell id="c48" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#2E7D4F;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="368.0" y="621.8" width="70.0" height="24.0" as="geometry"/></mxCell><mxCell id="c49" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;Strong&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=13;fontColor=#FFFFFF;align=center;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="368.0" y="625.8" width="70.0" height="17.6" as="geometry"/></mxCell><mxCell id="c50" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;One short model call a day, two with a retry. Zero on days the bank is used.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="368.0" y="655.8" width="401.0" height="44.0" as="geometry"/></mxCell><mxCell id="c51" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FCE9E7;strokeColor=#B83A2E;strokeWidth=1.5;html=1;" vertex="1" parent="1"><mxGeometry x="797.0" y="605.8" width="433.0" height="108.0" as="geometry"/></mxCell><mxCell id="c52" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#B83A2E;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="813.0" y="621.8" width="70.0" height="24.0" as="geometry"/></mxCell><mxCell id="c53" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;Weak&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=13;fontColor=#FFFFFF;align=center;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="813.0" y="625.8" width="70.0" height="17.6" as="geometry"/></mxCell><mxCell id="c54" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;A full tool loop every morning, often with screenshots. A usage cap can stop the run.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="813.0" y="655.8" width="401.0" height="44.0" as="geometry"/></mxCell><mxCell id="c55" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#DCE2EA;strokeWidth=1.0;html=1;" vertex="1" parent="1"><mxGeometry x="1242.0" y="605.8" width="118.0" height="108.0" as="geometry"/></mxCell><mxCell id="c56" value="" style="ellipse;fillColor=#2256A0;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="1279.0" y="629.8" width="44.0" height="44.0" as="geometry"/></mxCell><mxCell id="c57" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;A&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=22;fontColor=#FFFFFF;align=center;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1242.0" y="637.8" width="118.0" height="28.4" as="geometry"/></mxCell><mxCell id="c58" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;pipeline&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=12.5;fontColor=#606673;align=center;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1242.0" y="679.8" width="118.0" height="17.0" as="geometry"/></mxCell><mxCell id="c59" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#F3F5F8;strokeColor=#DCE2EA;strokeWidth=1.0;html=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="725.8" width="300.0" height="108.0" as="geometry"/></mxCell><mxCell id="c60" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;Streak safety&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=19;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="56.0" y="741.8" width="268.0" height="26.7" as="geometry"/></mxCell><mxCell id="c61" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;What happens when something breaks?&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14;fontColor=#606673;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="56.0" y="775.8" width="268.0" height="21.6" as="geometry"/></mxCell><mxCell id="c62" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#E7F4EC;strokeColor=#2E7D4F;strokeWidth=1.5;html=1;" vertex="1" parent="1"><mxGeometry x="352.0" y="725.8" width="433.0" height="108.0" as="geometry"/></mxCell><mxCell id="c63" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#2E7D4F;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="368.0" y="741.8" width="70.0" height="24.0" as="geometry"/></mxCell><mxCell id="c64" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;Strong&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=13;fontColor=#FFFFFF;align=center;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="368.0" y="745.8" width="70.0" height="17.6" as="geometry"/></mxCell><mxCell id="c65" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;Model down: bank questions. Upload fails: queued and retried. Mac asleep: catch-up run.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="368.0" y="775.8" width="401.0" height="44.0" as="geometry"/></mxCell><mxCell id="c66" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FCE9E7;strokeColor=#B83A2E;strokeWidth=1.5;html=1;" vertex="1" parent="1"><mxGeometry x="797.0" y="725.8" width="433.0" height="108.0" as="geometry"/></mxCell><mxCell id="c67" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#B83A2E;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="813.0" y="741.8" width="70.0" height="24.0" as="geometry"/></mxCell><mxCell id="c68" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;Weak&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=13;fontColor=#FFFFFF;align=center;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="813.0" y="745.8" width="70.0" height="17.6" as="geometry"/></mxCell><mxCell id="c69" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;If the model is down or out of quota, the whole routine stops and the day is lost.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="813.0" y="775.8" width="401.0" height="44.0" as="geometry"/></mxCell><mxCell id="c70" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#DCE2EA;strokeWidth=1.0;html=1;" vertex="1" parent="1"><mxGeometry x="1242.0" y="725.8" width="118.0" height="108.0" as="geometry"/></mxCell><mxCell id="c71" value="" style="ellipse;fillColor=#2256A0;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="1279.0" y="749.8" width="44.0" height="44.0" as="geometry"/></mxCell><mxCell id="c72" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;A&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=22;fontColor=#FFFFFF;align=center;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1242.0" y="757.8" width="118.0" height="28.4" as="geometry"/></mxCell><mxCell id="c73" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;pipeline&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=12.5;fontColor=#606673;align=center;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1242.0" y="799.8" width="118.0" height="17.0" as="geometry"/></mxCell><mxCell id="c74" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#F3F5F8;strokeColor=#DCE2EA;strokeWidth=1.0;html=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="845.8" width="300.0" height="108.0" as="geometry"/></mxCell><mxCell id="c75" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;Security &amp;amp; privacy&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=19;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="56.0" y="861.8" width="268.0" height="26.7" as="geometry"/></mxCell><mxCell id="c76" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;Blast radius around camera, tokens and YouTube&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14;fontColor=#606673;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="56.0" y="895.8" width="268.0" height="41.2" as="geometry"/></mxCell><mxCell id="c77" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#E7F4EC;strokeColor=#2E7D4F;strokeWidth=1.5;html=1;" vertex="1" parent="1"><mxGeometry x="352.0" y="845.8" width="433.0" height="108.0" as="geometry"/></mxCell><mxCell id="c78" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#2E7D4F;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="368.0" y="861.8" width="70.0" height="24.0" as="geometry"/></mxCell><mxCell id="c79" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;Strong&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=13;fontColor=#FFFFFF;align=center;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="368.0" y="865.8" width="70.0" height="17.6" as="geometry"/></mxCell><mxCell id="c80" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;Tokens are used only by reviewed code paths. Private upload is hard-coded, not prompted.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="368.0" y="895.8" width="401.0" height="44.0" as="geometry"/></mxCell><mxCell id="c81" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFF5DC;strokeColor=#B7791F;strokeWidth=1.5;html=1;" vertex="1" parent="1"><mxGeometry x="797.0" y="845.8" width="433.0" height="108.0" as="geometry"/></mxCell><mxCell id="c82" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#B7791F;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="813.0" y="861.8" width="70.0" height="24.0" as="geometry"/></mxCell><mxCell id="c83" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;Mixed&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=13;fontColor=#FFFFFF;align=center;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="813.0" y="865.8" width="70.0" height="17.6" as="geometry"/></mxCell><mxCell id="c84" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;Broad tools plus live tokens in a prompt-driven loop. Prompt-injection and mis-click risk.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="813.0" y="895.8" width="401.0" height="44.0" as="geometry"/></mxCell><mxCell id="c85" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#DCE2EA;strokeWidth=1.0;html=1;" vertex="1" parent="1"><mxGeometry x="1242.0" y="845.8" width="118.0" height="108.0" as="geometry"/></mxCell><mxCell id="c86" value="" style="ellipse;fillColor=#2256A0;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="1279.0" y="869.9" width="44.0" height="44.0" as="geometry"/></mxCell><mxCell id="c87" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;A&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif