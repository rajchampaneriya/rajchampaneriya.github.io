v style=&quot;line-height:1.2;&quot;&gt;What we gain&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=19;fontColor=#2256A0;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60.0" y="1181.9" width="386.7" height="24.8" as="geometry"/></mxCell><mxCell id="c114" value="" style="ellipse;fillColor=#5E85BA;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="60.5" y="1224.4" width="7.0" height="7.0" as="geometry"/></mxCell><mxCell id="c115" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;The same run every day; each failure is fixed once, in code&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="76.0" y="1217.9" width="370.7" height="44.0" as="geometry"/></mxCell><mxCell id="c116" value="" style="ellipse;fillColor=#5E85BA;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="60.5" y="1274.5" width="7.0" height="7.0" as="geometry"/></mxCell><mxCell id="c117" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;About one model call a day&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="76.0" y="1268.0" width="370.7" height="23.0" as="geometry"/></mxCell><mxCell id="c118" value="" style="ellipse;fillColor=#5E85BA;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="60.5" y="1303.5" width="7.0" height="7.0" as="geometry"/></mxCell><mxCell id="c119" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;The streak survives model, network and upload outages&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="76.0" y="1297.0" width="370.7" height="23.0" as="geometry"/></mxCell><mxCell id="c120" value="" style="ellipse;fillColor=#5E85BA;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="60.5" y="1332.5" width="7.0" height="7.0" as="geometry"/></mxCell><mxCell id="c121" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;Credentials are used only by reviewed code paths&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="76.0" y="1326.0" width="370.7" height="23.0" as="geometry"/></mxCell><mxCell id="c122" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#DCE2EA;strokeWidth=1.0;html=1;" vertex="1" parent="1"><mxGeometry x="486.7" y="1161.9" width="426.7" height="218.1" as="geometry"/></mxCell><mxCell id="c123" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;What we accept&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=19;fontColor=#2256A0;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="506.7" y="1181.9" width="386.7" height="24.8" as="geometry"/></mxCell><mxCell id="c124" value="" style="ellipse;fillColor=#5E85BA;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="507.2" y="1224.4" width="7.0" height="7.0" as="geometry"/></mxCell><mxCell id="c125" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;New behaviour means new code, written and tested with Claude Code&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="522.7" y="1217.9" width="370.7" height="44.0" as="geometry"/></mxCell><mxCell id="c126" value="" style="ellipse;fillColor=#5E85BA;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="507.2" y="1274.5" width="7.0" height="7.0" as="geometry"/></mxCell><mxCell id="c127" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;About 3,500 lines of Python and 35 automated tests to maintain&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="522.7" y="1268.0" width="370.7" height="44.0" as="geometry"/></mxCell><mxCell id="c128" value="" style="ellipse;fillColor=#5E85BA;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="507.2" y="1324.5" width="7.0" height="7.0" as="geometry"/></mxCell><mxCell id="c129" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;Only the questions adapt; everything else is fixed until changed&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="522.7" y="1318.0" width="370.7" height="44.0" as="geometry"/></mxCell><mxCell id="c130" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#DCE2EA;strokeWidth=1.0;html=1;" vertex="1" parent="1"><mxGeometry x="933.3" y="1161.9" width="426.7" height="218.1" as="geometry"/></mxCell><mxCell id="c131" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;Revisit when&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=19;fontColor=#2256A0;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="953.3" y="1181.9" width="386.7" height="24.8" as="geometry"/></mxCell><mxCell id="c132" value="" style="ellipse;fillColor=#5E85BA;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="953.8" y="1224.4" width="7.0" height="7.0" as="geometry"/></mxCell><mxCell id="c133" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;Agents run unattended desktop tasks reliably for months&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="969.3" y="1217.9" width="370.7" height="23.0" as="geometry"/></mxCell><mxCell id="c134" value="" style="ellipse;fillColor=#5E85BA;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="953.8" y="1253.5" width="7.0" height="7.0" as="geometry"/></mxCell><mxCell id="c135" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;Per-run model cost becomes negligible&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="969.3" y="1247.0" width="370.7" height="23.0" as="geometry"/></mxCell><mxCell id="c136" value="" style="ellipse;fillColor=#5E85BA;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="953.8" y="1282.5" width="7.0" height="7.0" as="geometry"/></mxCell><mxCell id="c137" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;The routine starts changing every week&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=14.5;fontColor=#151A28;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="969.3" y="1276.0" width="370.7" height="23.0" as="geometry"/></mxCell><mxCell id="c138" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;fillColor=#1D4987;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="1404.1" width="1320.0" height="96.5" as="geometry"/></mxCell><mxCell id="c139" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;Principle: agentic at build time, deterministic at run time.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSerif%3Awght%40400%3B600%3B700;fontSize=22;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="64.0" y="1424.1" width="1272.0" height="28.4" as="geometry"/></mxCell><mxCell id="c140" value="&lt;div style=&quot;line-height:1.45;&quot;&gt;Claude Code designed, built, tested and debugged this pipeline. At 05:30 the system makes one bounded model call and no agent decisions.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=15.5;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="64.0" y="1458.1" width="1272.0" height="24.5" as="geometry"/></mxCell><mxCell id="c141" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;rajc.work  |  github.com/rajchampaneriya/fde-impromptu-coach&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%3B700;fontSize=13;fontColor=#606673;align=right;verticalAlign=top;spacing=0;spacingTop=0;overflow=visible;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40.0" y="1518.6" width="1320.0" height="20.2" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>